# Canicarrera — copy to .env for local dev. Real values NEVER go in the repo;
# on Replit they go in the Secrets panel.

# Port the server binds. Replit expects 5000.
PORT=5000

# Where telemetry lands. "jsonl" writes ./data/telemetry.jsonl (local dev only —
# Autoscale's filesystem is ephemeral). "console" logs one line per event.
# "none" disables it.
TELEMETRY_SINK=jsonl

# How many candidate races the curator simulates before picking one (§2.1).
# Higher = better races, more CPU per request. ~50ms at 20.
CURATION_CANDIDATES=20

# Max races held in the in-memory registry before the oldest are evicted.
RACE_REGISTRY_SIZE=500
