run = "npm run dev"
modules = ["nodejs-22"]
hidden = [".config", "dist", "node_modules"]

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"

# Autoscale: request-driven, scales to zero, billed on ALLOCATED resources for
# the time an instance is handling work. Stage 0 never renders video on the
# server, so it does not need a big machine — provisioning 4 vCPU / 8 GiB
# "just in case" would make every request ~4x more expensive for no gain.
#
#   Publishing -> Adjust settings -> Machine configuration
#     CPU:          1 vCPU
#     RAM:          2 GiB
#     Max machines: 1-3
#
# NOTE: `npm install` is deliberately absent from the build command. Replit runs
# the install step itself; adding it here runs it twice.
[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80
